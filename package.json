{
  "name": "smart-garage-management",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Garage Management System",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}